{
    "name": "ldaidone/laravel-ddd-commands",
    "description": "A lightweight toolkit that adds Domain-Driven Design scaffolding to any Laravel project. Generate domains, use cases, entities, value objects, repositories, and more with expressive artisan commands — keeping your architecture clean and consistent with zero friction.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "ddd",
        "domain-driven-design",
        "artisan",
        "scaffolding"
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0 || ^11.0",
        "illuminate/console": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ldaidone\\LaravelDddCommands\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ldaidone\\LaravelDddCommands\\LaravelDddCommandsServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Leo Daidone",
            "email": "leo.daidone@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "ddd-commands",
            "type": "path",
            "url": "../laravel-ddd-commands"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "composer/audit": true
        }
    }
}
